{
	"schemaVersion": 1,
	"id": "tidal_nn",
	"version": "${version}",
	"name": "Tidal (NN fork)",
	"description": "Adds ambient tidal waves to beaches and oceans. NN fork of Tidal by Superkat32 (MIT), with the mod id changed to tidal_nn so it can coexist with the original.",
	"authors": [
		"Superkat32",
		"uema5a (NN fork)"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/tidal-waves",
		"issues": "https://github.com/Superkat32/Tidal/issues",
		"sources": "https://github.com/Superkat32/Tidal"
	},
	"license": "MIT",
	"icon": "assets/tidal_nn/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"net.superkat.tidalnn.Tidal"
		],
		"client": [
			"net.superkat.tidalnn.TidalClient"
		],
		"modmenu": [
			"net.superkat.tidalnn.config.ModMenuInt"
		]
	},
	"mixins": [
		"tidal_nn.mixins.json"
	],
	"accessWidener": "tidal_nn.accesswidener",
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"midnightlib": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}